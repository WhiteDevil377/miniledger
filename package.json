{
  "name": "miniledger",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @miniledger/api",
    "dev:app": "npm run start -w @miniledger/mobile",
    "dev:web": "npm run web -w @miniledger/mobile",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "npm run db:migrate -w @miniledger/api",
    "db:seed": "npm run db:seed -w @miniledger/api",
    "test": "npm run test -w @miniledger/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "build:api": "npm run build -w @miniledger/api",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "tsx": "^4.20.0"
  },
  "type": "module",
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
