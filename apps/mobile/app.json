{
  "expo": {
    "name": "MiniLedger",
    "slug": "miniledger",
    "scheme": "miniledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miniledger.app"
    },
    "android": {
      "package": "com.miniledger.app",
      "adaptiveIcon": {
        "backgroundColor": "#D9F59A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "MiniLedger",
      "description": "Good friends. Clear accounts. Track the little loans you make to friends."
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a receipt photo for your loan entry.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
